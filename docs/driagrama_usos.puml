@startuml casos
actor Cliente 
actor Administrador

rectangle "Sistema de Ecommerce" {
    usecase "Registrarse en el sistema" as UC1
    usecase "Iniciar sesión" as UC2

    usecase "Explorar catálogo" as UC3
    usecase "Filtrar por franquicia" as UC3_1

    usecase "Gestionar carrito de compras" as UC4
    usecase "Agregar producto al carrito" as UC4_1
    usecase "Modificar cantidad / Eliminar" as UC4_2

    usecase "Confirmar pedido" as UC5
    usecase "Seleccionar método de pago" as UC5_1

    usecase "Consultar historial de pedidos" as UC6

    usecase "Gestionar productos e inventario" as UC7
    usecase "Actualizar stock" as UC7_1
}

Cliente --> UC1
Cliente --> UC2
Cliente --> UC3
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6

UC3 ..> UC3_1 : <<extend>>
UC4 ..> UC4_1 : <<include>>
UC4 ..> UC4_2 : <<include>>
UC5 ..> UC5_1 : <<include>>

Administrador --> UC2
Administrador --> UC7

UC7 ..> UC7_1 : <<include>>

@enduml