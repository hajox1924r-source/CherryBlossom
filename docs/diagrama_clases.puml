@startuml clases_mejoradas

skinparam classAttributeIconSize 0

' =========================
' ENUMS
' =========================
enum EstadoPedido {
  Pendiente
  Pagado
  Enviado
  Entregado
  Cancelado
}

enum EstadoPago {
  Pendiente
  Aprobado
  Rechazado
  Reembolsado
}

enum EstadoEnvio {
  Preparando
  EnCamino
  Entregado
  Retrasado
}

' =========================
' USUARIOS
' =========================
abstract class Usuario {
  - id: int
  - nombre: String
  - correo: String
  - contraseña: String
  + iniciarSesion(): boolean
  + cerrarSesion(): void
}

class Cliente {
  - direccion: String
  - telefono: String
}

class Administrador {
  + gestionarProductos(): void
  + gestionarPedidos(): void
}

Usuario <|-- Cliente
Usuario <|-- Administrador

' =========================
' PRODUCTOS
' =========================
abstract class Producto {
  - id: int
  - nombre: String
  - precio: double
  - stock: int
  - descripcion: String
}

abstract class ProductoFisico {
  - peso: double
  + calcularCostoEnvio(): double
}

Producto <|-- ProductoFisico

class Categoria {
  - id: int
  - nombre: String
  - descripcion: String
}

class Franquicia {
  - id: int
  - nombre: String
  - autorOriginal: String
}

Producto "*" --> "1" Categoria
Producto "*" --> "1" Franquicia

Administrador --> Producto : administra

' =========================
' IMÁGENES
' =========================
class ImagenProducto {
  - url: String
  - principal: boolean
}

Producto "1" *-- "*" ImagenProducto

' =========================
' PRODUCTOS EDITORIALES
' =========================
abstract class ProductoEditorial {
  - autor: String
  - editorial: String
  - numeroPaginas: int
}

ProductoFisico <|-- ProductoEditorial

class Manga {
  - tomo: int
  - isbn: String
}

class Manhwa {
  - temporada: int
  - idioma: String
}

class NovelaLigera {
  - volumen: int
  - ilustrador: String
}

ProductoEditorial <|-- Manga
ProductoEditorial <|-- Manhwa
ProductoEditorial <|-- NovelaLigera
