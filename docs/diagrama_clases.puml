@startuml clases_mejoradas

skinparam classAttributeIconSize 0

' =========================
' ENUMS
' =========================
enum EstadoPedido {
  Pendiente
  Pagado
  Enviado
  Entregado
  Cancelado
}

enum EstadoPago {
  Pendiente
  Aprobado
  Rechazado
  Reembolsado
}

enum EstadoEnvio {
  Preparando
  EnCamino
  Entregado
  Retrasado
}

' =========================
' USUARIOS
' =========================
abstract class Usuario {
  - id: int
  - nombre: String
  - correo: String
  - contraseña: String
  + iniciarSesion(): boolean
  + cerrarSesion(): void
}

class Cliente {
  - direccion: String
  - telefono: String
}

class Administrador {
  + gestionarProductos(): void
  + gestionarPedidos(): void
}

Usuario <|-- Cliente
Usuario <|-- Administrador

' =========================
' PRODUCTOS
' =========================
abstract class Producto {
  - id: int
  - nombre: String
  - precio: double
  - stock: int
  - descripcion: String
}

abstract class ProductoFisico {
  - peso: double
  + calcularCostoEnvio(): double
}

Producto <|-- ProductoFisico

class Categoria {
  - id: int
  - nombre: String
  - descripcion: String
}

class Franquicia {
  - id: int
  - nombre: String
  - autorOriginal: String
}

Producto "*" --> "1" Categoria
Producto "*" --> "1" Franquicia

Administrador --> Producto : administra

' =========================
' IMÁGENES
' =========================
class ImagenProducto {
  - url: String
  - principal: boolean
}

Producto "1" *-- "*" ImagenProducto

' =========================
' PRODUCTOS EDITORIALES
' =========================
abstract class ProductoEditorial {
  - autor: String
  - editorial: String
  - numeroPaginas: int
}

ProductoFisico <|-- ProductoEditorial

class Manga {
  - tomo: int
  - isbn: String
}

class Manhwa {
  - temporada: int
  - idioma: String
}

class NovelaLigera {
  - volumen: int
  - ilustrador: String
}

ProductoEditorial <|-- Manga
ProductoEditorial <|-- Manhwa
ProductoEditorial <|-- NovelaLigera

' =========================
' MERCHANDISING
' =========================
abstract class Merchandising {
  - material: String
}

ProductoFisico <|-- Merchandising

class Ropa {
  - talla: String
}

class Accesorio {
  - tipo: String
  - material: String
}

class Poster {
  - dimensiones: String
}

Merchandising <|-- Ropa
Merchandising <|-- Accesorio
Merchandising <|-- Poster

' =========================
' OTROS PRODUCTOS
' =========================
class FiguraColeccionable {
  - escala: String
  - material: String
}

class AlbumMusical {
  - artista: String
  - numeroCanciones: int
}

ProductoFisico <|-- FiguraColeccionable
ProductoFisico <|-- AlbumMusical

class ProductoDigital {
  - formato: String
  - tamañoMB: double
  + descargar(): void
}

Producto <|-- ProductoDigital

' =========================
' INVENTARIO
' =========================
class Inventario {
  - cantidadDisponible: int
  - cantidadReservada: int
  + actualizarStock(): void
}

Producto --> Inventario

' =========================
' RESEÑAS
' =========================
class Reseña {
  - calificacion: int
  - comentario: String
  - fecha: Date
}

Cliente --> "*" Reseña
Producto --> "*" Reseña

' =========================
' LISTA DE DESEOS
' =========================
class ListaDeseos {
  + agregarProducto(): void
  + eliminarProducto(): void
}

Cliente --> "1" ListaDeseos
ListaDeseos --> "*" Producto

' =========================
' CARRITO
' =========================
class CarritoDeCompras {
  - total: double
  + agregarProducto(): void
  + eliminarProducto(): void
  + calcularTotal(): double
}

class ItemCarrito {
  - cantidad: int
  - subtotal: double
}

Cliente "1" --> "1" CarritoDeCompras

CarritoDeCompras "1" *-- "*" ItemCarrito

ItemCarrito "*" --> "1" Producto

' =========================
' PEDIDOS
' =========================
class Pedido {
  - id: int
  - fecha: Date
  - estado: EstadoPedido
  - total: double
  + confirmarPedido(): void
  + cancelarPedido(): void
}

class ItemPedido {
  - cantidad: int
  - subtotal: double
}

Cliente "1" --> "*" Pedido

Pedido "1" *-- "*" ItemPedido

ItemPedido "*" --> "1" Producto

' =========================
' PAGOS
' =========================
interface MetodoPago {
  + procesarPago(): boolean
}

class PagoTarjeta {
  - numeroTarjeta: String
}

class PagoPayPal {
  - correoPayPal: String
}

class PagoNequi {
  - numeroCelular: String
}

MetodoPago <|.. PagoTarjeta
MetodoPago <|.. PagoPayPal
MetodoPago <|.. PagoNequi

class Pago {
  - id: int
  - fecha: Date
  - monto: double
  - estado: EstadoPago
  + confirmarPago(): boolean
}

Pedido --> "1" Pago

Pago --> "1" MetodoPago

' =========================
' ENVÍO
' =========================
class Envio {
  - direccion: String
  - estado: EstadoEnvio
  - fechaEntregaEstimada: Date
  + actualizarEstado(): void
}

Pedido --> "1" Envio

@enduml